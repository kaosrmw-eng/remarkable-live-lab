# Copy to the device as gomarkable-private.env, permission 0600.
# Set a long unique password before starting. Never commit the filled file.
RK_SERVER_BIND_ADDR=127.0.0.1:2001
RK_SERVER_USERNAME=owner
RK_SERVER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
RK_HTTPS=false
RK_JWT_ENABLED=true
RK_JWT_SECRET_DIR=/home/root/gomarkable-move-test/secrets
RK_TAILSCALE_ENABLED=true
RK_TAILSCALE_HOSTNAME=remarkable-live
RK_TAILSCALE_STATE_DIR=/home/root/gomarkable-move-test/tailscale
RK_TAILSCALE_EPHEMERAL=false
RK_TAILSCALE_FUNNEL=false
RK_TAILSCALE_USE_TLS=true
RK_TAILSCALE_PORT=:443
RK_PUBLIC_VIEWER=true
